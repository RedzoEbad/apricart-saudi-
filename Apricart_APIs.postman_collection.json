{
  "info": {
    "_postman_id": "apricart-upload-apis-collection",
    "name": "Apricart Upload & Post APIs",
    "description": "Targeted collection for posting and uploading Banners, Categories, SubCategories, and Products.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://185.164.25.196:8081",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "banner_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "subcategory_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Banners",
      "item": [
        {
          "name": "Post Banner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Language",
                "value": "ENG"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer Promotion Banner\",\n  \"arabicName\": \"بنر عروض الصيف\",\n  \"status\": true,\n  \"level\": \"ONE\",\n  \"position\": \"TOP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/open/banners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "open",
                "banners"
              ]
            }
          }
        },
        {
          "name": "Upload Banner Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Language",
                "value": "ENG"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/open/banners/image/update/{{banner_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "open",
                "banners",
                "image",
                "update",
                "{{banner_id}}"
              ]
            }
          }
        }
      ]
    },
