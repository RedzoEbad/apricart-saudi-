# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/apricart
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# Server Configuration
SERVER_PORT=8081
SERVER_CONSUMER_BASEURL=http://localhost:8081

# Email Configuration (SMTP)
SPRING_MAIL_HOST=smtp-mail.outlook.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apricartsaudi@outlook.com
SPRING_MAIL_PASSWORD=your_mail_password
EMAIL_SALES=sales@apricart.ai

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=8080

# Firebase Configuration
# Path to your firebase-adminsdk JSON file inside src/main/resources
APP_FIREBASE_CONFIGURATION_FILE=google/apricart-81547-firebase-adminsdk-xccpi-a7204458f5.json

# Security Configuration
JWT_SECRET=mySecretKey

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000,http://localhost:44512

# Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
